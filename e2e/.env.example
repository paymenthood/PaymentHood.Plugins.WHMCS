# ─────────────────────────────────────────────────────────────────────────────
# PaymentHood WHMCS E2E configuration
# Copy this file to ".env" and fill in the values for YOUR local environment.
# ─────────────────────────────────────────────────────────────────────────────

# --- WHMCS install (XAMPP / WAMP / local PHP) -------------------------------
# Public base URL of your WHMCS install (NO trailing slash).
WHMCS_BASE_URL=http://localhost/whmcs
# Admin folder name (WHMCS lets you rename it; default is "admin").
WHMCS_ADMIN_PATH=admin

# Filesystem path to the WHMCS install root (where init.php lives).
# Used by `npm run deploy` to copy the plugin files in. Windows example:
WHMCS_ROOT=C:\xampp\htdocs\whmcs

# --- WHMCS admin credentials (for gateway activation + order verification) ---
WHMCS_ADMIN_USER=admin
WHMCS_ADMIN_PASS=changeme

# --- Storefront customer used to place the test order ------------------------
# An EXISTING client account. If you want the test to register a fresh client
# instead, set CLIENT_REGISTER=true and these become the new account's creds.
CLIENT_REGISTER=false
CLIENT_EMAIL=test.customer@example.com
CLIENT_PASSWORD=Test1234!
CLIENT_FIRST_NAME=Test
CLIENT_LAST_NAME=Customer

# --- Product to buy ----------------------------------------------------------
# Product ID of a cheap/free-domain test product configured in WHMCS.
# Find it under Admin > System Settings > Products/Services (pid in the URL).
PRODUCT_PID=1
# Billing cycle option value to pick (monthly | annually | onetime ...).
PRODUCT_BILLING_CYCLE=monthly

# --- PaymentHood sandbox (real sandbox flow) ---------------------------------
# Merchant login used during gateway OAuth activation (PaymentHood Console).
PH_MERCHANT_EMAIL=merchant@example.com
PH_MERCHANT_PASSWORD=changeme

# Sandbox test card / payment details entered on the hosted checkout page.
PH_CARD_NUMBER=4111111111111111
PH_CARD_EXP=12/30
PH_CARD_CVC=123
PH_CARD_NAME=Test Customer
# Name (visible text) of the sandbox gateway/provider to pick on the hosted
# page, if PaymentHood shows a provider list. Leave blank to take the first one.
PH_PROVIDER_NAME=

# --- Optional: direct DB assertions (stronger order/invoice verification) ----
# If set, tests also assert invoice + order status straight from the DB.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=whmcs
DB_USER=root
DB_PASS=
